# No trailing slash on .venv / web/node_modules: a trailing slash matches a
# DIRECTORY only, and in a git worktree these are usually symlinks back to the
# main checkout (neither is created by `git worktree add`, both are gitignored,
# so every worktree needs its own or a link to one). As `.venv/` they showed up
# as untracked and were one `git add .` away from committing an absolute path
# to somebody's home directory.
.venv
firmware/.esphome/
firmware/secrets.yaml
audio/*.wav
audio/*.mp3
# Render products too: the SD build's card_bitrate copies and the speaker
# test's tones (`make audio` writes both; sd_sync pushes them).
audio/card/
audio/test/
# Imported audio is the user's own; the scene definitions that use it are
# tracked, the files are not.
tracks/*
!tracks/README.md
!tracks/tracks.json
__pycache__/
*.pyc
.DS_Store
web/node_modules
web/dist/

# Playwright
web/test-results/
web/playwright-report/
web/blob-report/

# Local analysis artifacts
.coverage
dogfood-output/
# The scene editor's backup and scratch files.
scenes/*.bak
scenes/*.tmp
