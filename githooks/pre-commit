#!/bin/sh
# The fast gates, at commit time — the slow ones (tests, e2e) stay in
# `make check` and CI. Installed by `make setup` (git config core.hooksPath
# githooks). Same interpreter rule as the Makefile: the project venv when
# it exists, else whatever python3 is on PATH — a worktree without its own
# .venv used to fail on the first line.
set -e
cd "$(git rev-parse --show-toplevel)"
PY=$(command -v .venv/bin/python || command -v python3)
# The Makefile's PY_SCOPE, spelled once here too: demo/castle-radio joined the
# Python gate on 2026-09-17 (grade report 2026-09-17 D2).
SCOPE="tools tests demo/castle-radio"
"$PY" -m ruff format --check --quiet $SCOPE || { echo "pre-commit: formatting drift — run: $PY -m ruff format $SCOPE" >&2; exit 1; }
"$PY" -m ruff check $SCOPE
"$PY" -m mypy $SCOPE
# --hook fails at 490, not the 500 cap: a file is only ever added to at
# commit time, so this is the gate that should stop before the cliff. Ten
# lines of room means the split is chosen, not forced mid-change (grade
# report 2026-09-01 I3). `make check` and CI still enforce the cap itself.
"$PY" tools/check_loc.py --hook

# The same walk, one line later: an audit citation with no date names six
# reports at once, and the cheapest moment to date it is while the audit that
# raised it is still the thing on screen.
"$PY" tools/check_citations.py

# The TS half gets the same gate as the Python half (grade report 2026-08-23 I1) —
# with a tsconfig this strict, tsc is the highest-value check in the repo.
# Guarded on the local compiler so a Python-only clone still commits, and so
# `npx tsc` cannot fetch the unrelated npm `tsc` package.
if [ -x web/node_modules/.bin/tsc ]; then
  (cd web && ./node_modules/.bin/tsc --noEmit)
fi

# The Rust half gets the cheap half of its gate too (grade report 2026-08-31 I2):
# fmt --check reads the sources and never builds, so it costs under a second
# — the tests and clippy stay in `make rust-lint` / `make rust-test` and CI.
# Guarded on cargo the same way, so a Python-only clone still commits.
# `cd core` for the same reason the Makefile does it: rustup reads
# core/rust-toolchain.toml by working directory, not by manifest path.
if command -v cargo > /dev/null 2>&1; then
  (cd core && cargo fmt --check) \
    || { echo "pre-commit: rustfmt drift — run: cd core && cargo fmt" >&2; exit 1; }
fi

# The repo's only real secret is one gitignore line away from history (E2):
# refuse a staged secrets.yaml, and refuse any staged file that contains the
# actual PSK (read from the live file, never echoed).
if git diff --cached --name-only | grep -q 'secrets\.yaml$'; then
  echo "pre-commit: firmware/secrets.yaml is staged — that file never lands in git" >&2
  exit 1
fi
if [ -f firmware/secrets.yaml ]; then
  PSK=$(sed -n 's/^wifi_password:[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' firmware/secrets.yaml | head -1)
  if [ -n "$PSK" ] && git diff --cached | grep -qF -- "$PSK"; then
    echo "pre-commit: a staged change contains the WiFi password — remove it" >&2
    exit 1
  fi
fi
