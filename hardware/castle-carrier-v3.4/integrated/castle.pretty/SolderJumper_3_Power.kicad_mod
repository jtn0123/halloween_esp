(footprint "SolderJumper_3_Power"
	(version 20241209)
	(generator "castle-carrier-gen")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "3-pad solder jumper for a POWER path, pads 1-2 bridged out of the fab. 3.0 x 3.5 mm pads on a 3.80 mm pitch, so the slot between pads 1 and 2 is 0.80 mm; the bridge that fills it is 2.50 mm of copper, the width of this board's fused trunk (4.71 A at a 10 degC rise, IPC-2221). Pad 2 is the centre, the load. Cut 1-2 and bridge 2-3 to change over. Net tie on pads 1-2, because the two sides are different nets and the bridge is not a short.")
	(tags "net tie solder jumper bridged 12")
